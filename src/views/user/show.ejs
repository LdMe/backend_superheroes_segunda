<%- include('../layout/header', { title: user ? user.username : 'Usuario no encontrado' }); -%>

<% if (user) { %>
    <%- include('userCard', { user }) -%>

    <%# /user/me usa esta misma vista: los botones solo los ve un admin %>
    <% if (currentUser && currentUser.role === "admin") { %>
    <div class="actions">
        <a class="button" href="/user/<%= user.userId %>/edit">Editar</a>
        <form method="post" action="/user/<%= user.userId %>/delete" data-confirm="¿Seguro que quieres eliminar a <%= user.username %>? También se borrarán sus héroes.">
            <button class="danger">Eliminar</button>
        </form>
    </div>
    <% } %>

    <section>
        <h3>Héroes creados</h3>
        <% if (user.heroes.length === 0) { %>
            <p>Este usuario todavía no ha creado ningún héroe.</p>
        <% } %>
        <ul>
            <% for (const hero of user.heroes) { %>
                <li><a href="/hero/<%= hero.heroId %>"><%= hero.name %></a>: <%= hero.description %></li>
            <% } %>
        </ul>
    </section>
<% } else { %>
    <p>No existe el usuario</p>
<% } %>

<a href="/user">Volver</a>
<%- include('../layout/footer'); -%>
