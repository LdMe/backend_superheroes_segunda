<article class="user-card">
    <h3><%= user.username %></h3>
    <p>Email: <%= user.email %></p>
    <p>Rol: <%= user.role %></p>
    <a href="/user/<%=user.userId%>">Visitar</a>
    <form method="post" action="/user/<%=user.userId%>/delete">
        <button>Eliminar</button>
    </form>

</article>