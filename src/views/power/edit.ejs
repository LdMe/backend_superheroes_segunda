<%- include('../layout/header', { title: 'Editar poder' }); -%>

<h2>Editar poder</h2>
<%- include('../layout/error') -%>

<form action="/power/<%= power.powerId %>/edit" method="post">
    <label for="name">Nombre</label>
    <input type="text" name="name" id="name" value="<%= power.name %>" required>

    <label for="description">Descripción</label>
    <textarea id="description" name="description"><%= power.description %></textarea>

    <label for="utility_level">Nivel de utilidad (1-10)</label>
    <input type="number" name="utility_level" id="utility_level" min="1" max="10" value="<%= power.utility_level %>" required>

    <button>Guardar</button>
</form>

<a href="/power/<%= power.powerId %>">Volver</a>
<%- include('../layout/footer'); -%>
