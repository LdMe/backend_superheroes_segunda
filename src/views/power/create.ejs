<%- include('../layout/header', { title: 'Nuevo poder' }); -%>

<h2>Nuevo poder</h2>
<%- include('../layout/error') -%>

<form action="/power" method="post">
    <label for="name">Nombre</label>
    <input type="text" name="name" id="name" value="<%= power.name %>" required>

    <label for="description">Descripción</label>
    <textarea id="description" name="description"><%= power.description %></textarea>

    <label for="utility_level">Nivel de utilidad (1-10)</label>
    <input type="number" name="utility_level" id="utility_level" min="1" max="10" value="<%= power.utility_level ?? 5 %>" required>

    <button>Crear</button>
</form>

<a href="/power">Volver</a>
<%- include('../layout/footer'); -%>
