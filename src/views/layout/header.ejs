<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%# "locals" contiene todas las variables que recibe la vista: así no falla si no nos pasan title %>
    <title><%= locals.title ? title + " | " : "" %>Superhéroes de segunda</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
    <nav>
        <h1><a href="/">Superhéroes de segunda</a></h1>
        <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/hero">Héroes</a></li>
            <li><a href="/power">Poderes</a></li>
            <%# currentUser es el usuario logueado (lo pone un middleware en index.js) %>
            <% if (!currentUser) { %>
                <li><a href="/auth/login">Login</a></li>
                <li><a href="/auth/register">Registro</a></li>
            <% } else { %>
                <li><a href="/user/me">Mis héroes</a></li>
                <% if (currentUser.role === "admin") { %>
                    <li><a href="/user">Usuarios</a></li>
                <% } %>
                <li><a href="/auth/logout">Salir (<%= currentUser.username %>)</a></li>
            <% } %>
        </ul>
    </nav>
</header>
<main>
